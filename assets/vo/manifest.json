    "intro-1": {
      "file": "assets/vo/intro-1.mp3",
      "voice": "aura-2-draco-en",
      "text": "Once, the bells of Vespergrave called the living home. Then the king asked for a kingdom that would never end.",
      "scriptHash": "b438fe0c7f4b2bdeac603927df19625cb1cbb214758f2d4a5d663428d0a51e74",
