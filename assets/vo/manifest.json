    "ending-silence": {
      "file": "assets/vo/ending-silence.mp3",
      "voice": "aura-2-draco-en",
      "text": "You broke the hollow crown, and gave the stolen names to morning. The dead lie still. Above the ruined kingdom, the first bird begins to sing.",
